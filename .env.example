# Browser-visible key: restrict to Maps JavaScript API and your HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Private server key: used with Geocoding API v4. A Demo Key may be reused here
# for local prototyping only; use a separate restricted key in production.
GOOGLE_MAPS_SERVER_KEY=

# GPS readings less accurate than this will be rejected by the server.
MAX_GPS_ACCURACY_METERS=50

# Maximum distance between the confirmed location and Google's address point.
MAX_ADDRESS_DISTANCE_METERS=2000
